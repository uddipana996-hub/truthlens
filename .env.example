# ==============================================================================
# TruthLens — Environment Variables Example
# Copy this file to `.env` for local development.
# NEVER commit real secrets or API keys to version control.
# ==============================================================================

# GEMINI_API_KEY: Server-side Google Gemini API key (standard AIza... key from Google AI Studio).
GEMINI_API_KEY=

# GEMINI_MODEL: Optional model override (defaults to gemini-4-hydrogen with automatic Flash fallback).
# GEMINI_MODEL=gemini-4-hydrogen

# APP_URL: Public base URL of the running application (auto-set in hosted envs).
APP_URL=http://localhost:3000

# ==============================================================================
# Optional Social Media Platform Credentials
# Note: Meta and X credentials are completely separate from Gemini credentials
# and are only needed if you want official API/oEmbed retrieval for those platforms.
# Without them, TruthLens AI gracefully prompts users with paste/screenshot fallback.
# ==============================================================================

# META_ACCESS_TOKEN: Meta App or Client Token for Instagram / Facebook oEmbed.
META_ACCESS_TOKEN=

# X_BEARER_TOKEN: X (Twitter) API v2 Bearer Token for public tweet lookup.
X_BEARER_TOKEN=
